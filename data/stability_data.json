 "findings": [
  {
   "id": "F1",
   "title": "Legacy startup script times out early",
   "result": "MGS wait limit is about 145-170 s instead of 300 s because the loop counts iterations, not seconds; the same bug made the LNET wait about 11 s instead of 60 s.",
   "evidence": "13:14 cold start (8/10 failed), legacy run 3 (Compute-2 FATAL after 145 s)"
  },
  {
   "id": "F2",
   "title": "Head-1 (MGS) is always the last node up",
   "result": "Head-1 reaches the OS about 190 s after its own power-on versus about 90 s for the other blades; every cold start depends on this gap.",
   "evidence": "head1_os_up_s 193-248 across all runs"
  },
  {
   "id": "F3",
   "title": "Fix verified",
   "result": "With wall-clock deadlines the computes waited up to 344 s for the MGS (Head-1 held 240 s) and all 10 nodes mounted with 0 fatal retries; the legacy script would have failed at about 145 s.",
   "evidence": "fixed run with head1_delay_s=240"
  },
  {
   "id": "F4",
   "title": "Data integrity across unclean power-off",
   "result": "40 of 40 files (256 MB each, written with direct I/O) sha256-identical after each of 2 hard power-offs of all 10 nodes.",
   "evidence": "integrity runs 17:31 and 17:45"
  },
  {
   "id": "F5",
   "title": "OST recovery window after unclean stop",
   "result": "After a hard stop of all nodes only 2 of 16 OSTs were visible for another 275-292 s after all nodes reported mounted (OST recovery window 5:00; MDT mounted with abort_recov reconnects as a new client and is denied). After a graceful shutdown the pool was complete immediately. Accepted, not changed: production shutdowns are scheduled.",
   "evidence": "pool_fully_visible_after_mounted_s 275 and 292"
  },
  {
   "id": "F6",
   "title": "Kernel update would break the boot",
   "result": "dnf update installed the Rocky 9.8 kernel on Compute-2 and UPDATEDEFAULT=yes made it the boot default; the node came up without Lustre modules. Fixed with kernel* excluded in the update playbook and UPDATEDEFAULT=no on all nodes.",
   "evidence": "thesis notes/15"
  }
 ],
